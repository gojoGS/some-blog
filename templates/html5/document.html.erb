<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8">
  <title><%= document.title %></title>
  <link rel="icon" href="favicon.ico">
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Amaranth:wght@400;700&family=DM+Sans:opsz,wght@9..40,300..700&display=swap" rel="stylesheet">
  <%= docinfo %>
  <link rel="stylesheet" href="rouge.css">
  <link rel="stylesheet" href="style.css">
</head>

<body>
  <header>
    <a href="index.html">Some(Blog)</a>
  </header>

  <h1>
    <%= document.title %>
  </h1>

  <main>
    <%= content %>
  </main>

  <footer>
    © 2026
  </footer>

  <% if footnotes? %>
    <div id="footnotes">
      <hr>
      <% footnotes.each do |fn| %>
        <div class="footnote" id="_footnotedef_<%= fn.index %>">
          <a href="#_footnoteref_<%= fn.index %>"><%= fn.index %></a>.
          <%= fn.text %>
        </div>
      <% end %>
    </div>
  <% end %>

  <script>
    document
      .querySelectorAll("main h2, main h3, main h4, main h5, main h6, body > h1")
      .forEach(function (h) {
        h.addEventListener("click", function () {
          var url =
            location.origin +
            location.pathname +
            (h.id ? "#" + h.id : "");
          navigator.clipboard.writeText(url).then(function () {
            h.classList.add("copied");
            setTimeout(function () {
              h.classList.remove("copied");
            }, 1200);
          });
        });
      });
  </script>
</body>
</html>
