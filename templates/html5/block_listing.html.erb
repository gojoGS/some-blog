<div class="listingblock">
  <% if title? %>
  <div class="title">
    <span class="title-text"><%= captioned_title %></span>
    <% if attr? :language %>
    <span class="title-lang"><%= attr :language %></span>
    <% end %>
  </div>
  <% end %>
  <div class="content">
    <% if attr? :language %>
    <pre class="highlight"><code class="language-<%= attr :language %>" data-lang="<%= attr :language %>"><%= content %></code></pre>
    <% else %>
    <pre><%= content %></pre>
    <% end %>
  </div>
</div>